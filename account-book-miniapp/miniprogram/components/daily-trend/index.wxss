.trend { position: relative; width: 100%; overflow: hidden; }
.legend { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #697386; font-size: 24rpx; }
.legend-series { display: flex; align-items: center; gap: 10rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-left: 12rpx; }
.income-dot { background: #3e7dd6; }
.expense-dot { background: #b85654; }
.trend-plot { position: relative; width: 100%; height: 400rpx; overflow: hidden; }
.grid-line { position: absolute; height: 1px; background: #edf0f5; }
.axis-y, .axis-x { position: absolute; font-size: 10px; line-height: 16px; color: #7a8495; white-space: nowrap; }
.axis-y { left: 0; width: 40px; text-align: right; transform: translateY(-50%); }
.axis-x { width: 40px; margin-left: -20px; text-align: center; }
.trend-segment { position: absolute; height: 2px; transform-origin: 0 50%; }
.trend-dot { position: absolute; width: 5px; height: 5px; border-radius: 50%; transform: translate(-50%, -50%); }
.series-income { background: #3e7dd6; }
.series-expense { background: #b85654; }
.fallback { display: block; color: #697386; font-size: 24rpx; }
