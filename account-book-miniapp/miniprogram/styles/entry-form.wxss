@import './refined.wxss';
.entry-form-page { gap: 24rpx; }
.type-options { display: flex; padding: 8rpx; margin-bottom: 24rpx; background: #f1f3f7; border-radius: 14rpx; gap: 8rpx; }
.entry-form-page button.type-option { flex: 1; width: auto; min-width: 0; margin: 0; text-align: center; padding: 12rpx; color: #667085; border-radius: 10rpx; font-size: 30rpx; font-weight: 400; line-height: 1.5; background: transparent; }
.type-option::after { border: 0; }
.entry-form-page button.type-option.active { color: #1f2329; background: #fff; font-weight: 500; box-shadow: 0 2rpx 8rpx rgba(31,35,41,.04); }
.amount-label { font-size: 24rpx; color: #667085; }
.amount-field { display: flex; align-items: center; gap: 16rpx; border-bottom: 1rpx solid #e2e6ec; padding: 12rpx 0; }
.amount-symbol { font-size: 36rpx; }
.amount-field input { flex: 1; width: 0; min-width: 0; font-size: 64rpx; line-height: 1.4; height: 96rpx; font-weight: 500; }
.field-row { display: flex; align-items: center; gap: 24rpx; min-height: 100rpx; border-bottom: 1rpx solid #e2e6ec; }
.field-row:last-child { border-bottom: 0; }
.field-label { color: #667085; flex: none; font-size: 28rpx; min-width: 60rpx; }
.field-row picker { flex: 1; min-width: 0; }
.field-row input { flex: 1; width: 0; text-align: right; font-size: 30rpx; min-width: 0; }
.field-value { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; min-height: 96rpx; font-size: 30rpx; }
.field-value text:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.field-hint { display: block; color: #667085; font-size: 24rpx; margin: 12rpx 0; }
.note-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.note-heading text:last-child { color: #667085; font-size: 24rpx; }
.note-input { width: 100%; min-height: 160rpx; font-size: 30rpx; line-height: 1.6; }
.form-actions { display: flex; flex-direction: column; gap: 16rpx; }
.form-actions .return-button { color: #667085; background: transparent; border: 0; box-shadow: none; }
