<view class="page home-page refined-page tab-page">
  <view class="hero-card gradient-banner">
    <view class="hero-top"><text>固定共享账本</text><text>随手账</text></view>
    <text class="hero-title">{{ledgerName || '正在加载账本'}}</text>
    <text class="hero-subtitle" wx:if="{{nickname}}">你好，{{nickname}}</text>
  </view>

  <view class="error-panel" wx:if="{{errorMessage}}">
    <text class="error-message">{{errorMessage}}</text>
    <text class="request-id" wx:if="{{requestId}}" user-select="true">请求编号：{{requestId}}</text>
    <button class="button button-secondary" loading="{{loading}}" disabled="{{loading}}" bindtap="retry">重新加载</button>
  </view>

  <view class="section">
    <text class="section-title">快捷记账</text>
    <view class="shortcut-grid">
      <button class="shortcut-card" disabled="{{loading || loggingOut || !displayName}}" bindtap="openFavorEntry" hover-class="shortcut-hover"><image class="shortcut-icon" src="/assets/icons/gift.png" mode="aspectFit" aria-hidden="true"/><view class="shortcut-copy"><text class="shortcut-title">人情记账</text><text class="shortcut-subtitle">礼金 · 往来</text></view></button>
      <button class="shortcut-card" disabled="{{loading || loggingOut || !displayName}}" bindtap="openLifeEntry" hover-class="shortcut-hover"><image class="shortcut-icon" src="/assets/icons/house.png" mode="aspectFit" aria-hidden="true"/><view class="shortcut-copy"><text class="shortcut-title">生活记账</text><text class="shortcut-subtitle">日常 · 开支</text></view></button>
    </view>
  </view>

  <view class="section" wx:if="{{displayName}}">
    <view class="section-heading">
      <text class="section-title">最近账单</text>
      <button class="text-button" bindtap="openEntries">全部明细</button>
    </view>
    <view class="error-panel" wx:if="{{recentError}}">
      <text class="error-message">{{recentError}}</text>
      <text class="request-id" wx:if="{{recentRequestId}}" user-select="true">请求编号：{{recentRequestId}}</text>
      <button class="button button-secondary" loading="{{recentLoading}}" disabled="{{recentLoading}}" bindtap="retryRecent">重试</button>
    </view>
    <view class="card recent-list" wx:elif="{{recentEntries.length}}">
      <view class="recent-row" wx:for="{{recentEntries}}" wx:key="id" data-id="{{item.id}}" bindtap="openEntries">
        <view class="recent-main"><view class="recent-heading"><text class="recent-name">{{item.entryDate}} · {{item.categoryName}}</text><text class="direction-tag {{item.entryType === 'INCOME' ? 'tag-income' : 'tag-expense'}}">{{item.entryType === 'INCOME' ? '收入' : '支出'}}</text></view><text class="recent-meta">{{item.entryDate}}{{item.personName ? ' · ' + item.personName : ''}}</text></view>
        <text class="recent-amount {{item.entryType === 'INCOME' ? 'income' : 'expense'}}">{{item.entryType === 'INCOME' ? '+' : '-'}} {{item.amount}}</text>
      </view>
    </view>
    <view class="card loading-card" wx:else><text>{{recentLoading ? '正在加载最近账单…' : '还没有账单'}}</text></view>
  </view>

  <view class="bookkeeping-row">
    <text class="section-title">收支记账</text>
    <button class="button button-primary pill-primary" disabled="{{loading || loggingOut}}" bindtap="openEntryCreate">记一笔</button>
    <button class="text-button statistics-link" disabled="{{loading || loggingOut}}" bindtap="openStatistics">月度统计 <text class="chevron"/></button>
  </view>

  <view class="section" wx:if="{{canManageCatalog}}">
    <text class="section-title">记账字典</text>
    <view class="card catalog-actions">
      <button class="catalog-button" disabled="{{loading || loggingOut}}" bindtap="openCategories">分类管理 <text class="chevron"/></button>
      <button class="catalog-button" disabled="{{loading || loggingOut}}" bindtap="openAccounts">资金账户管理 <text class="chevron"/></button>
    </view>
  </view>

  <button class="home-logout" loading="{{loggingOut}}" disabled="{{loggingOut || loading}}" bindtap="logout">退出登录</button>
</view>
