<view class="page home-page tab-page">
  <view class="hero-card">
    <text class="hero-kicker">固定共享账本</text>
    <text class="hero-title">{{ledgerName || '正在加载账本'}}</text>
    <text class="hero-subtitle" wx:if="{{nickname}}">你好，{{nickname}}</text>
  </view>

  <view class="error-panel" wx:if="{{errorMessage}}">
    <text class="error-message">{{errorMessage}}</text>
    <text class="request-id" wx:if="{{requestId}}" user-select="true">请求编号：{{requestId}}</text>
    <button class="button button-secondary" loading="{{loading}}" disabled="{{loading}}" bindtap="retry">重新加载</button>
  </view>

  <view class="section">
    <text class="section-title">快捷记账</text>
    <view class="card catalog-actions">
      <button class="button button-primary" disabled="{{loading || loggingOut || !displayName}}" bindtap="openFavorEntry">人情记账</button>
      <button class="button button-secondary" disabled="{{loading || loggingOut || !displayName}}" bindtap="openLifeEntry">生活记账</button>
    </view>
  </view>

  <view class="section" wx:if="{{displayName}}">
    <view class="section-heading">
      <text class="section-title">最近账单</text>
      <button class="text-button" bindtap="openEntries">全部明细</button>
    </view>
    <view class="error-panel" wx:if="{{recentError}}">
      <text class="error-message">{{recentError}}</text>
      <text class="request-id" wx:if="{{recentRequestId}}" user-select="true">请求编号：{{recentRequestId}}</text>
      <button class="button button-secondary" loading="{{recentLoading}}" disabled="{{recentLoading}}" bindtap="retryRecent">重试</button>
    </view>
    <view class="card recent-list" wx:elif="{{recentEntries.length}}">
      <view class="recent-row" wx:for="{{recentEntries}}" wx:key="id" data-id="{{item.id}}" bindtap="openEntries">
        <view class="recent-main"><text class="recent-name">{{item.categoryName}}</text><text class="recent-meta">{{item.entryDate}} · {{item.accountName}}</text></view>
        <text class="recent-amount {{item.entryType === 'INCOME' ? 'income' : 'expense'}}">{{item.entryType === 'INCOME' ? '+' : '-'}}¥{{item.amount}}</text>
      </view>
    </view>
    <view class="card loading-card" wx:else><text>{{recentLoading ? '正在加载最近账单…' : '还没有账单'}}</text></view>
  </view>

  <view class="section">
    <text class="section-title">收支记账</text>
    <view class="card catalog-actions">
      <button class="button button-primary" disabled="{{loading || loggingOut}}" bindtap="openEntryCreate">记一笔</button>
      <button class="button button-secondary" disabled="{{loading || loggingOut}}" bindtap="openEntries">查看账单</button>
      <button class="button button-secondary" disabled="{{loading || loggingOut}}" bindtap="openStatistics">月度统计</button>
    </view>
  </view>

  <view class="section">
    <text class="section-title">记账字典</text>
    <view class="card catalog-actions">
      <button class="button button-secondary" disabled="{{loading || loggingOut}}" bindtap="openCategories">分类{{canManageCatalog ? '管理' : '查看'}}</button>
      <button class="button button-secondary" disabled="{{loading || loggingOut}}" bindtap="openAccounts">资金账户{{canManageCatalog ? '管理' : '查看'}}</button>
    </view>
  </view>

  <button class="button button-danger" loading="{{loggingOut}}" disabled="{{loggingOut || loading}}" bindtap="logout">退出登录</button>
</view>
