<view class="page">
  <view class="toolbar">
    <picker range="{{['全部状态','启用','停用']}}" bindchange="onStatusFilter"><view>状态：{{status || '全部'}}</view></picker>
    <button wx:if="{{canManage}}" size="mini" bindtap="openCreate">新增</button>
  </view>
  <view wx:if="{{loading}}">加载中…</view>
  <view class="error-panel" wx:if="{{errorMessage}}">{{errorMessage}}<text wx:if="{{requestId}}">请求编号：{{requestId}}</text><button size="mini" disabled="{{loading || busy}}" loading="{{loading}}" bindtap="retry">重新加载</button></view>
  <view class="empty" wx:if="{{!loading && !errorMessage && items.length === 0}}">暂无账户</view>
  <view class="card row" wx:for="{{items}}" wx:key="id">
    <view>
      <text>{{item.name}} · {{item.accountType}}</text>
      <text class="muted">初始 {{item.initialBalance}} CNY · 当前 {{item.currentBalance}} CNY</text>
      <text class="muted">{{item.status}} · 排序 {{item.sortNo}}</text>
    </view>
    <view wx:if="{{canManage}}">
      <button size="mini" data-id="{{item.id}}" bindtap="openEdit">编辑/启停</button>
      <button size="mini" type="warn" data-id="{{item.id}}" bindtap="onDelete">删除</button>
    </view>
  </view>
</view>
