.filters-card{margin-bottom:20rpx}.filter-toggle{display:flex;justify-content:space-between;align-items:center;font-weight:600}.filter-toggle text:last-child{color:#3478f6;font-weight:400}.filters{display:flex;flex-direction:column;gap:16rpx;margin-top:18rpx}.actions,.pager,.row{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.row{margin-top:16rpx}.row>view{display:flex;flex-direction:column}.pager{margin-top:24rpx}

.entry-main{flex:1;min-width:0}
.entry-meta{display:flex;align-items:center;min-width:0;min-height:1.4em}
.entry-person,.entry-note{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.entry-person{flex-shrink:0;max-width:100%}
.entry-person.with-note{max-width:50%}
.entry-separator{flex-shrink:0;white-space:pre}
.entry-note{flex:1;min-width:0}
.entry-amount{flex-shrink:0;white-space:nowrap}
