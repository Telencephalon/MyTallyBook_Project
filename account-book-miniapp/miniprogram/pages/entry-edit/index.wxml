<view class="page refined-page entry-form-page">
  <view class="error-panel" wx:if="{{errorMessage}}"><text>{{errorMessage}}</text><text wx:if="{{requestId}}">请求编号：{{requestId}}</text><button class="button button-secondary" wx:if="{{canRetryRead}}" disabled="{{loading || busy}}" loading="{{loading}}" bindtap="retry">重新加载</button><button class="button button-secondary" wx:if="{{canReload}}" disabled="{{loading || busy}}" bindtap="onReload">确认重新加载</button></view>
  <view class="card">
    <view class="type-options" role="group" aria-label="选择收支类型">
      <button class="type-option {{entryType === 'EXPENSE' ? 'active' : ''}}" disabled="{{!canEdit || loading || busy || canReload || canRetryRead}}" data-type="EXPENSE" bindtap="onTypeChange" hover-class="none" aria-pressed="{{entryType === 'EXPENSE'}}">支出</button>
      <button class="type-option {{entryType === 'INCOME' ? 'active' : ''}}" disabled="{{!canEdit || loading || busy || canReload || canRetryRead}}" data-type="INCOME" bindtap="onTypeChange" hover-class="none" aria-pressed="{{entryType === 'INCOME'}}">收入</button>
    </view>
    <text class="amount-label">金额</text><view class="amount-field"><text class="amount-symbol">¥</text><input disabled="{{!canEdit || loading || busy || canReload || canRetryRead}}" type="digit" value="{{amount}}" placeholder="0.00" bindinput="onAmountInput" aria-label="金额"/></view>
  </view>
  <view class="card">
    <view class="field-row"><text class="field-label">分类</text><picker disabled="{{!canEdit || loading || busy || canReload || canRetryRead}}" range="{{categoryOptions}}" range-key="name" bindchange="onCategoryChange"><view class="field-value"><text>{{selectedCategoryName || '请选择分类'}}</text><text class="chevron"/></view></picker></view>
    <text class="field-hint" wx:if="{{categoryOptions.length && categoryOptions[categoryOptions.length-1].original}}">原分类已停用，仅本账单可保留</text>
    <view class="field-row"><text class="field-label">账户</text><picker disabled="{{!canEdit || loading || busy || canReload || canRetryRead}}" range="{{accountOptions}}" range-key="name" bindchange="onAccountChange"><view class="field-value"><text>{{selectedAccountName || '请选择账户'}}</text><text class="chevron"/></view></picker></view>
    <text class="field-hint" wx:if="{{accountOptions.length && accountOptions[accountOptions.length-1].original}}">原账户已停用，仅本账单可保留</text>
    <view class="field-row"><text class="field-label">日期</text><picker disabled="{{!canEdit || loading || busy || canReload || canRetryRead}}" mode="date" value="{{entryDate}}" start="1000-01-01" end="9999-12-31" bindchange="onDateChange"><view class="field-value"><text>{{entryDate}}</text><text class="chevron"/></view></picker></view>
    <view class="field-row"><text class="field-label">人名</text><input disabled="{{!canEdit || loading || busy || canReload || canRetryRead}}" maxlength="64" value="{{personName}}" placeholder="请输入人名（选填）" bindinput="onPersonNameInput" aria-label="人名"/></view>
  </view>
  <view class="card"><view class="note-heading"><text>备注</text><text>选填</text></view><textarea class="note-input" disabled="{{!canEdit || loading || busy || canReload || canRetryRead}}" maxlength="500" value="{{note}}" placeholder="写下这笔账的用途" bindinput="onNoteInput" aria-label="备注"/></view>
  <text class="field-hint" wx:if="{{!canEdit}}">当前账单不可编辑</text>
  <button wx:if="{{canEdit}}" class="button button-primary" loading="{{busy}}" disabled="{{loading || busy || canReload || canRetryRead}}" bindtap="onSubmit">保存修改</button>
</view>
