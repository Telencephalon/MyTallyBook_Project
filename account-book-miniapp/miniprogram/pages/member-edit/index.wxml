<view class="page">
  <view class="intro"><text class="eyebrow">共享账本 · 成员详情</text><text class="title">{{name || '成员详情'}}</text><text class="role">{{roleName}}</text></view>
  <view class="error-panel" wx:if="{{errorMessage}}"><text class="error-message">{{errorMessage}}</text><text class="request-id" wx:if="{{requestId}}">请求编号：{{requestId}}</text></view>
  <button class="button button-secondary" disabled="{{loading || busy}}" loading="{{loading}}" bindtap="loadMember">刷新身份与成员</button>
  <view class="card" wx:if="{{target}}">
    <text class="label">成员资料</text><text class="description">昵称：{{target.nickname}}</text><text class="description">加入：{{target.joinedAt}}（UTC）</text>
    <text class="hint">未设置成员别名时展示昵称。本阶段不修改成员别名。</text>
  </view>
  <view class="card" wx:if="{{canChangeRole || canRemove || canTransfer}}">
    <text class="label">成员管理</text>
    <button wx:if="{{canChangeRole}}" class="button button-secondary" disabled="{{loading || busy}}" bindtap="onChangeRole">{{target.role === 'ADMIN' ? '降为普通成员' : '设为管理员'}}</button>
    <text wx:if="{{canChangeRole && target.role === 'ADMIN'}}" class="hint">移除管理员前，请先将其降为普通成员。</text>
    <button wx:if="{{canRemove}}" class="button button-danger" disabled="{{loading || busy}}" bindtap="onRemove">移除成员</button>
    <button wx:if="{{canTransfer}}" class="button button-danger" disabled="{{loading || busy}}" bindtap="onTransfer">转让所有权</button>
    <text wx:if="{{canTransfer}}" class="hint">转让后，你将成为普通成员（MEMBER）。</text>
  </view>
  <text wx:if="{{target && !canChangeRole && !canRemove && !canTransfer}}" class="hint">当前身份没有针对该成员的管理操作。退出自己的账本请返回成员列表。</text>
</view>
