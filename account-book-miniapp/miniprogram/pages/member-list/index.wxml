<view class="page">
  <view class="intro"><text class="eyebrow">共享账本 · 成员</text><text class="title">一起记好每一笔</text><text class="description">有效成员 {{activeCount}} / {{maxMembers}} 人</text></view>
  <view class="error-panel" wx:if="{{errorMessage}}"><text class="error-message">{{errorMessage}}</text><text class="request-id" wx:if="{{requestId}}">请求编号：{{requestId}}</text></view>
  <button class="button button-secondary" disabled="{{loading || busy}}" loading="{{loading}}" bindtap="loadMembers">刷新成员</button>
  <view class="card">
    <view class="row" wx:for="{{items}}" wx:key="memberId">
      <text class="label">{{item.name}}</text><text class="role">{{item.roleLabel}}</text>
      <text class="description">加入：{{item.joinedAt}}（UTC）</text>
      <button class="button button-secondary" data-id="{{item.memberId}}" disabled="{{loading || busy}}" bindtap="openMember">查看成员</button>
    </view>
    <text class="description" wx:if="{{!items.length && !loading}}">暂无可显示的有效成员</text>
  </view>
  <view class="card" wx:if="{{canLeave}}">
    <text class="label">退出账本</text><text class="description">退出将失去访问权限，重新加入需要邀请。此操作不同于首页的“退出登录”。</text>
    <button class="button button-danger" disabled="{{loading || busy}}" loading="{{busy}}" bindtap="onLeave">退出账本</button>
  </view>
  <text class="hint" wx:else>所有者须先转让所有权，才能退出账本。</text>
</view>
