@import '../../styles/refined.wxss';
.statistics-page { gap: 28rpx; }
.statistics-page .statistics-banner { padding-bottom: 56rpx; }
.statistics-page .filter-card { position: relative; display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: -48rpx; margin-left: 12rpx; margin-right: 12rpx; padding: 24rpx; }
.filter-item { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 12rpx; }
.filter-label, .summary-label, .row-detail, .entry-count, .empty-text { color: #697386; font-size: 24rpx; }
.picker-value { padding: 16rpx 8rpx; border-radius: 12rpx; background: #f3f5fa; color: #253047; text-align: center; font-size: 26rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; }
.summary-grid { display: flex; padding-bottom: 28rpx; }
.summary-item { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 12rpx; text-align: center; }
.summary-item + .summary-item { border-left: 1rpx solid #e2e6ec; }
.summary-value { font-size: 40rpx; font-weight: 500; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.summary-net { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 20rpx; padding-top: 24rpx; border-top: 1rpx solid #e2e6ec; font-size: 28rpx; overflow-wrap: anywhere; }
.list-card { display: flex; flex-direction: column; gap: 24rpx; }
.daily-row, .account-row, .ranking-row { display: flex; flex-direction: column; gap: 12rpx; padding-bottom: 22rpx; border-bottom: 1rpx solid #edf0f5; }
.daily-row:last-child, .account-row:last-child, .ranking-row:last-child { padding-bottom: 0; border-bottom: 0; }
.row-line { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; font-size: 26rpx; overflow-wrap: anywhere; }
.row-name { color: #253047; font-weight: 500; }
.daily-money { display: flex; flex-wrap: wrap; gap: 18rpx; color: #475467; font-size: 24rpx; }
.range-actions { flex-basis: 100%; }
.range-row, .daily-pager, .pager-actions { display: flex; align-items: center; gap: 14rpx; }
.range-row picker { flex: 1; min-width: 0; }
.range-separator { color: #697386; font-size: 24rpx; }
.daily-pager { justify-content: space-between; flex-wrap: wrap; }
.bar-track { height: 20rpx; overflow: hidden; border-radius: 6rpx; background: #f0f3f9; }
.bar-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#3386df,#5276e7); }
.ranking-row:nth-child(even) .bar-fill { background: linear-gradient(90deg,#7664d9,#6656dc); }
.ranking-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #edf0f5; }
.ranking-caption { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; }
.ranking-label { font-size: 28rpx; font-weight: 600; }
.ranking-total { font-size: 28rpx; font-weight: 500; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.ranking-income .ranking-label, .ranking-income .ranking-total { color: #38764b; }
.ranking-expense .ranking-label, .ranking-expense .ranking-total { color: #99423e; }
.ranking-income .ranking-row .bar-fill { background: linear-gradient(90deg,#64b789,#389767); }
.ranking-expense .ranking-row .bar-fill { background: linear-gradient(90deg,#d28d83,#b85c57); }

/* Account and category cards share the soft color direction from the approved reference. */
.statistics-page .account-summary-card,
.statistics-page .category-group { border: 2rpx solid #fff; border-radius: 32rpx; padding: 28rpx; }
.statistics-page .account-summary-card {
  background: radial-gradient(ellipse at 85% 90%,rgba(255,220,230,.45),transparent 55%), linear-gradient(115deg,#fffaf0 0%,#edfbf5 42%,#edf6ff 75%,#f6effb 100%);
  box-shadow: 0 14rpx 32rpx rgba(88,101,133,.12);
  gap: 26rpx;
}
.account-summary-card .account-row { gap: 14rpx; padding-bottom: 26rpx; border-bottom-color: rgba(106,125,145,.17); }
.account-summary-card .account-row:last-child { padding-bottom: 0; }
.row-caption { display: flex; align-items: center; flex: 1; min-width: 160rpx; gap: 14rpx; }
.row-caption .row-name { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 30rpx; }
.flow-icon { display: inline-flex; align-items: center; justify-content: center; flex: none; box-sizing: border-box; width: 34rpx; height: 34rpx; border-radius: 50%; color: #fff; font-size: 27rpx; font-weight: 600; line-height: 1; box-shadow: inset 0 2rpx 3rpx rgba(255,255,255,.24), 0 2rpx 4rpx rgba(26,59,66,.08); }
.flow-positive, .ranking-income .flow-icon { background: linear-gradient(150deg,#5bd494,#09a77b); }
.flow-negative, .ranking-expense .flow-icon { background: linear-gradient(150deg,#ff9995,#ea575e); }
.flow-neutral { background: linear-gradient(150deg,#a5b1c2,#8290a4); }
.account-net, .category-amount { max-width: 100%; margin-left: auto; text-align: right; color: #283344; font-size: 27rpx; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.account-breakdown { color: #485363; font-size: 25rpx; line-height: 1.65; overflow-wrap: anywhere; }
.statistics-page .category-group { gap: 24rpx; }
.statistics-page .category-group.ranking-income {
  background: radial-gradient(ellipse at 100% 0%,rgba(163,237,208,.45),transparent 65%), linear-gradient(115deg,#ecfaf3,#f2fbf6);
  box-shadow: 0 12rpx 30rpx rgba(35,166,119,.1);
}
.statistics-page .category-group.ranking-expense {
  background: radial-gradient(ellipse at 100% 0%,rgba(255,192,190,.38),transparent 60%), linear-gradient(115deg,#fff1f2,#fff3f2);
  box-shadow: 0 12rpx 30rpx rgba(214,91,98,.09);
}
.category-group .ranking-heading { gap: 14rpx; padding-bottom: 24rpx; }
.category-group .ranking-caption { gap: 12rpx; }
.category-group .ranking-caption .row-detail { color: #55665f; }
.category-group.ranking-expense .ranking-caption .row-detail { color: #756062; }
.category-group .ranking-label { font-size: 30rpx; }
.category-group .ranking-total { margin-left: auto; max-width: 100%; text-align: right; font-size: 30rpx; font-weight: 600; }
.category-group.ranking-income .ranking-label, .category-group.ranking-income .ranking-total { color: #158b66; }
.category-group.ranking-expense .ranking-label { color: #d7615d; }
.category-group.ranking-expense .ranking-total { color: #b84040; }
.category-group.ranking-income .ranking-heading, .category-group.ranking-income .ranking-row { border-bottom-color: rgba(53,139,104,.16); }
.category-group.ranking-expense .ranking-heading, .category-group.ranking-expense .ranking-row { border-bottom-color: rgba(179,91,99,.16); }
.category-group .direction-icon { width: 36rpx; height: 36rpx; font-size: 32rpx; font-weight: 400; }
.category-group .ranking-row { gap: 14rpx; padding-bottom: 24rpx; }
.category-group .ranking-row:last-child { padding-bottom: 0; }
.category-group .category-icon { width: 32rpx; height: 32rpx; font-size: 25rpx; }
.category-group .bar-track { height: 20rpx; border-radius: 20rpx; }
.category-group.ranking-income .bar-track { background: #cfeede; }
.category-group.ranking-expense .bar-track { background: #facfce; }
.category-group.ranking-income .ranking-row .bar-fill { background: linear-gradient(90deg,#0daf89,#8bda9b); }
.category-group.ranking-expense .ranking-row .bar-fill { background: linear-gradient(90deg,#f26665,#fa9b96); }

.state-card { color: #697386; text-align: center; }
.detail-toggle { display: flex; justify-content: space-between; align-items: center; width: 100%; margin: 0; padding: 14rpx 0; border: 0; background: none; font-size: 26rpx; line-height: 1.5; color: #486fd7; border-radius: 0; }
.detail-toggle::after { border: 0; }
