<view class="page refined-page statistics-page tab-page">
  <view class="gradient-banner statistics-banner"><text class="banner-title">收支统计</text><text class="banner-subtitle">{{appliedRangeLabel}} · 看清每一笔收支</text></view>
  <view class="filter-card card">
    <view class="filter-item" wx:if="{{canSelectCreator}}">
      <text class="filter-label">创建人</text>
      <picker range="{{creators}}" range-key="displayName" bindchange="onCreator"><view class="picker-value">{{creatorName}}</view></picker>
    </view>
    <view class="filter-item" wx:else><text class="filter-label">统计数据</text><text class="picker-value">仅我创建的账单</text></view>
    <view class="filter-item">
      <text class="filter-label">统计范围</text>
      <picker range="{{scopeLabels}}" value="{{scopeIndex}}" bindchange="onScopeChange">
        <view class="picker-value">{{scopeLabels[scopeIndex]}}</view>
      </picker>
    </view>
    <view class="filter-item" wx:if="{{scopeIndex === 0}}">
      <text class="filter-label">统计月份</text>
      <picker mode="date" fields="month" start="1000-01" end="9999-12" value="{{month}}" bindchange="onMonthChange">
        <view class="picker-value">{{month}}</view>
      </picker>
    </view>
    <view class="filter-item">
      <text class="filter-label">收支类型</text>
      <picker range="{{directionLabels}}" value="{{directionIndex}}" bindchange="onDirectionChange">
        <view class="picker-value">{{directionLabels[directionIndex]}}</view>
      </picker>
    </view>
    <view class="filter-item range-actions" wx:if="{{scopeIndex === 2}}">
      <text class="filter-label">自定义日期</text>
      <view class="range-row">
        <picker mode="date" start="1000-01-01" end="9999-12-31" value="{{customStartDate}}" bindchange="onCustomStartChange">
          <view class="picker-value">{{customStartDate}}</view>
        </picker>
        <text class="range-separator">至</text>
        <picker mode="date" start="1000-01-01" end="9999-12-31" value="{{customEndDate}}" bindchange="onCustomEndChange">
          <view class="picker-value">{{customEndDate}}</view>
        </picker>
      </view>
      <button class="button button-secondary" loading="{{loading}}" disabled="{{loading}}" bindtap="onApplyCustomRange">查询</button>
    </view>
  </view>

  <view class="error-panel" wx:if="{{loadState === 'error'}}">
    <text class="error-message">{{errorMessage}}</text>
    <text class="request-id" wx:if="{{requestId}}" user-select="true">请求编号：{{requestId}}</text>
    <button class="button button-secondary" loading="{{loading}}" disabled="{{loading}}" bindtap="retry">重新加载</button>
  </view>
  <view class="state-card card" wx:elif="{{loading && !summary}}"><text>正在加载统计…</text></view>
  <view class="state-card card" wx:elif="{{loadState === 'empty'}}"><text>所选范围暂无账单</text></view>

  <block wx:if="{{summary}}">
    <view class="section">
      <text class="section-title">{{appliedScope === 'MONTH' ? '月度概览' : '收支概览'}}</text>
      <view class="summary-card card">
        <view class="summary-grid">
          <view class="summary-item income"><text class="summary-label">总收入</text><text class="summary-value">+{{summary.income}}</text></view>
          <view class="summary-item expense"><text class="summary-label">总支出</text><text class="summary-value">-{{summary.expense}}</text></view>
        </view>
        <view class="summary-net"><text>结余 ¥{{summary.net}}</text><text class="entry-count">共 {{summary.entryCount}} 笔</text></view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">账户收支</text>
      <view class="card list-card account-summary-card">
        <view class="account-row" wx:for="{{accountItems}}" wx:key="id">
          <view class="row-line account-heading">
            <view class="row-caption"><text class="flow-icon {{item.net < 0 ? 'flow-negative' : item.net > 0 ? 'flow-positive' : 'flow-neutral'}}" aria-hidden="true">{{item.net < 0 ? '↓' : item.net > 0 ? '↑' : '−'}}</text><text class="row-name">{{item.name}}</text></view>
            <text class="account-net">净 ¥{{item.net}}</text>
          </view>
          <text class="account-breakdown">收入 {{item.income}} · 支出 {{item.expense}} · {{item.entryCount}} 笔</text>
        </view>
        <text class="empty-text" wx:if="{{!accountItems.length}}">暂无账户流水</text>
      </view>
    </view>

    <view class="section">
      <view class="section-heading"><text class="section-title">分类占比</text><text class="row-detail">按收支分别统计</text></view>
      <view class="card list-card category-group {{group.entryType === 'INCOME' ? 'ranking-income' : 'ranking-expense'}}" wx:for="{{categoryGroups}}" wx:for-item="group" wx:key="entryType">
        <view class="ranking-heading">
          <view class="ranking-caption"><text class="ranking-label">{{group.label}}</text><text class="row-detail">占总{{group.label}}比例</text><text class="flow-icon direction-icon" aria-hidden="true">{{group.entryType === 'INCOME' ? '+' : '−'}}</text></view>
          <text class="ranking-total">{{group.entryType === 'INCOME' ? '+' : '-'}} ¥{{group.total}}</text>
        </view>
        <view class="ranking-row" wx:for="{{group.items}}" wx:key="id">
          <view class="row-line category-heading">
            <view class="row-caption"><text class="flow-icon category-icon" aria-hidden="true">{{group.entryType === 'INCOME' ? '↑' : '↓'}}</text><text class="row-name">{{item.name}}</text></view>
            <text class="category-amount">¥{{item.amount}} · {{item.percentage}}%</text>
          </view>
          <view class="bar-track"><view class="bar-fill" style="width: {{item.width}}%;"></view></view>
        </view>
        <text class="empty-text" wx:if="{{!group.items.length}}">暂无{{group.label}}数据</text>
      </view>
      <view class="card state-card" wx:if="{{loading && !categoryGroups.length}}">正在加载分类占比…</view>
    </view>

    <view class="section">
      <text class="section-title">每日趋势</text>
      <view class="card list-card">
        <daily-trend wx:if="{{daily.length}}" items="{{daily}}" />
        <view class="daily-pager">
          <text class="row-detail">第 {{dailyPage}} / {{dailyTotalPages}} 页 · 共 {{dailyTotalDays}} 天</text>
          <view class="pager-actions">
            <button class="button button-secondary" size="mini" disabled="{{loading || dailyPage <= 1}}" bindtap="onDailyPrevious">上一页</button>
            <button class="button button-secondary" size="mini" disabled="{{loading || !dailyHasNext}}" bindtap="onDailyNext">下一页</button>
          </view>
        </view>
        <button class="detail-toggle" wx:if="{{daily.length}}" bindtap="toggleDailyDetails">{{dailyDetailsExpanded ? '收起每日明细' : '查看每日明细'}} <text>{{dailyDetailsExpanded ? '−' : '+'}}</text></button>
        <view class="daily-row" wx:for="{{daily}}" wx:key="date" wx:if="{{dailyDetailsExpanded}}">
          <text class="row-name">{{item.date}}</text>
          <view class="daily-money"><text class="income">+{{item.income}}</text><text class="expense">-{{item.expense}}</text><text>净 {{item.net}}</text></view>
        </view>
        <text class="empty-text" wx:if="{{!daily.length}}">所选范围暂无账单</text>
      </view>
    </view>

    <view class="section">
      <view class="section-heading"><text class="section-title">成员排行</text><text class="row-detail">按收支分别统计</text></view>
      <view class="card list-card member-group {{group.entryType === 'INCOME' ? 'ranking-income' : 'ranking-expense'}}" wx:for="{{memberGroups}}" wx:for-item="group" wx:key="entryType">
        <view class="ranking-heading">
          <view class="ranking-caption"><text class="ranking-label">{{group.label}}</text><text class="row-detail">占总{{group.label}}比例</text></view>
          <text class="ranking-total">{{group.entryType === 'INCOME' ? '+' : '-'}} ¥{{group.total}}</text>
        </view>
        <view class="ranking-row" wx:for="{{group.items}}" wx:key="id">
          <view class="row-line"><text class="row-name">{{item.name}}</text><text>¥{{item.amount}} · {{item.percentage}}%</text></view>
          <view class="bar-track"><view class="bar-fill" style="width: {{item.width}}%;"></view></view>
        </view>
        <text class="empty-text" wx:if="{{!group.items.length}}">暂无{{group.label}}数据</text>
      </view>
      <view class="card state-card" wx:if="{{loading && !memberGroups.length}}">正在加载成员排行…</view>
    </view>
  </block>
</view>
