.login-page {
  min-height: 100vh;
  justify-content: center;
  gap: 48rpx;
}

.brand-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.brand-mark {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: #1677ff;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 40rpx rgba(22, 119, 255, 0.2);
}

.brand-title {
  margin-top: 12rpx;
  color: #172033;
  font-size: 44rpx;
  font-weight: 700;
}

.brand-subtitle,
.security-note {
  color: #74809a;
  font-size: 26rpx;
}

.public-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.public-link {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #1677ff;
  font-size: 26rpx;
  line-height: 1.5;
}

.public-link::after {
  border: 0;
}

.link-divider {
  color: #98a2b3;
}

.status-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  text-align: center;
}

.status-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 600;
}

.status-description {
  color: #667085;
  font-size: 28rpx;
  line-height: 1.7;
}

.status-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e8f2ff;
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
}

.status-icon-error {
  background: #fff1f0;
  color: #d92d20;
}

.spinner {
  width: 54rpx;
  height: 54rpx;
  border: 6rpx solid #d8e8ff;
  border-top-color: #1677ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
