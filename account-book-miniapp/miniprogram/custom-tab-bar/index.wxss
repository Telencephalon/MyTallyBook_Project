.tab-bar {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  bottom: 0;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #e2e5eb;
  background: #ffffff;
}
.tab-items { display: flex; height: 120rpx; min-height: 60px; }
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #373c45;
  font-size: 24rpx;
  line-height: 1.4;
}
.tab-icon { width: 48rpx; height: 48rpx; margin-bottom: 4rpx; }
.tab-label { line-height: 34rpx; white-space: nowrap; }
.selected { color: #079c67; font-weight: 500; }
