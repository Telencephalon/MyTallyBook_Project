# Production HTTPS configuration for MyTallyBook.
# Replace every __API_DOMAIN__ token after the certificate has been issued.
# The server's existing public port 80 belongs to another application. This
# configuration intentionally listens on 443 only. Obtain the certificate by
# DNS-01 or import a trusted certificate without using HTTP-01 on port 80.
# Install as: /etc/nginx/sites-available/account-book.conf

log_format account_book
    '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
    '$status $body_bytes_sent rt=$request_time urt=$upstream_response_time '
    'rid=$request_id';

limit_req_zone  $binary_remote_addr zone=account_book_api:10m  rate=10r/s;
limit_req_zone  $binary_remote_addr zone=account_book_auth:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=account_book_conn:10m;

server {
    listen 443 ssl http2;
    server_name __API_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__API_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__API_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ACCOUNT_BOOK_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 2m;
    client_body_timeout 15s;
    send_timeout 30s;
    limit_req_status 429;
    limit_conn_status 429;

    access_log /var/log/nginx/account-book.access.log account_book;
    error_log  /var/log/nginx/account-book.error.log warn;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "nginx https ok\n";
    }

    # Current API baseline: /api/v1/auth/wechat/login.
    location = /api/v1/auth/wechat/login {
        limit_req zone=account_book_auth burst=5 nodelay;
        limit_conn account_book_conn 10;
        include /etc/nginx/snippets/account-book-proxy.inc;
    }

    location = /api/v1/auth/bootstrap {
        limit_req zone=account_book_auth burst=3 nodelay;
        limit_conn account_book_conn 5;
        include /etc/nginx/snippets/account-book-proxy.inc;
    }

    location = /api/v1/auth/invites/accept {
        limit_req zone=account_book_auth burst=5 nodelay;
        limit_conn account_book_conn 10;
        include /etc/nginx/snippets/account-book-proxy.inc;
    }

    location ^~ /api/v1/ {
        limit_req zone=account_book_api burst=20 nodelay;
        limit_conn account_book_conn 20;
        include /etc/nginx/snippets/account-book-proxy.inc;
    }

    # Do not expose Actuator, an API explorer, or arbitrary application paths.
    location / {
        return 404;
    }
}
