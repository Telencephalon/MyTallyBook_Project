# Loopback-only validation configuration used before the trusted TLS
# certificate exists. The server's existing public port 80 is reserved for
# another application and must not be claimed by MyTallyBook.
# Install as: /etc/nginx/sites-available/account-book.conf

log_format account_book
    '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
    '$status $body_bytes_sent rt=$request_time urt=$upstream_response_time '
    'rid=$request_id';

# Loopback-only reverse proxy for validation before HTTPS is available.
# Port 8081 must not be opened in UFW or the JD Cloud security group.
server {
    listen 127.0.0.1:8081;
    server_name localhost;

    server_tokens off;
    client_max_body_size 2m;
    access_log /var/log/nginx/account-book-local.access.log account_book;
    error_log  /var/log/nginx/account-book-local.error.log warn;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "nginx local proxy ok\n";
    }

    location ^~ /api/v1/ {
        include /etc/nginx/snippets/account-book-proxy.inc;
    }

    location / {
        return 404;
    }
}
