# First deployment: existing account_book_dev database on the same server.
# Template only. Replace every __FILL_*__ value before starting the service.
# Use original secrets. Do not regenerate APP_TOKEN_PEPPER during migration.
# systemd EnvironmentFile syntax: do not source this file in a shell.
# Store the completed file at /etc/account-book/account-book.env, root:root 0600.
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=7631
DB_URL="jdbc:mysql://127.0.0.1:3306/account_book_dev?connectionTimeZone=Asia/Shanghai"
DB_USERNAME=account_book_dev_app
DB_PASSWORD="__FILL_ORIGINAL_DATABASE_PASSWORD__"
WECHAT_APP_ID=wx9cb6fa756c2198d4
WECHAT_APP_SECRET="__FILL_ORIGINAL_WECHAT_APP_SECRET__"
APP_BOOTSTRAP_KEY="__FILL_ORIGINAL_BOOTSTRAP_KEY__"
APP_TOKEN_PEPPER="__FILL_ORIGINAL_TOKEN_PEPPER__"
SPRING_FLYWAY_CLEAN_DISABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
